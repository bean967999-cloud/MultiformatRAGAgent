# local 或 api；入库和检索必须使用同一个模型
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL_PATH=BAAI/bge-m3
LOCAL_EMBEDDING_DEVICE=cuda
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Milvus 服务地址，例如 http://localhost:19530
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=multiformat_rag_v2
# 每批向量化和写入的 Chunk 数量，1 到 256
INDEX_BATCH_SIZE=32

# OpenAI-compatible chat completions API
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
